{
    email {$ACME_EMAIL}
    admin off
}

{$DOMAIN} {
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }
    reverse_proxy web:8000 {
        # Flush SSE immediately; do not cache translation progress.
        flush_interval -1
    }
}
